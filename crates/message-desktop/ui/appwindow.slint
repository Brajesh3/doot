import { ListView } from "std-widgets.slint";

export struct ContactData {
    peer_key: string,
    nickname: string,
    initial: string,
    last_message: string,
    timestamp: string,
    unread_count: int,
    is_online: bool,
    is_direct: bool,
    rtt_ms: int,
    is_typing: bool,
}

export struct MessageData {
    id: string,
    is_mine: bool,
    content: string,
    timestamp: string,
    status: string,
    has_attachment: bool,
    file_name: string,
    file_size_text: string,
    is_directory: bool,
    local_path: string,
}

component IconButton inherits Rectangle {
    in-out property <image> icon;
    in-out property <color> icon-color: #94a3b8;
    in-out property <color> icon-hover-color: #f1f5f9;
    in-out property <color> bg-color: #20242e;
    in-out property <color> bg-hover-color: #2a303d;
    in-out property <length> icon-size: 18px;
    callback clicked <=> touch.clicked;

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: touch.has-hover ? bg-hover-color : bg-color;

    Image {
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: touch.has-hover ? root.icon-hover-color : root.icon-color;
        image-fit: contain;
    }

    touch := TouchArea {}
}

component CustomButton inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> primary: false;
    callback clicked <=> touch.clicked;

    height: 38px;
    border-radius: 19px;
    background: root.primary ?
        (touch.has-hover ? #1d4ed8 : #2563eb) :
        (touch.has-hover ? #2e384d : #222938);
    border-width: root.primary ? 0 : 1px;
    border-color: #3b4557;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.primary ? #ffffff : #cbd5e1;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {}
}

export component AppWindow inherits Window {
    title: "Doot - Sovereign P2P Messenger";
    min-width: 860px;
    min-height: 600px;
    preferred-width: 1060px;
    preferred-height: 720px;
    background: #0f1117;
    default-font-family: "Segoe UI";

    // Properties
    in-out property <[ContactData]> contacts: [];
    in-out property <int> selected_contact_index: -1;
    in-out property <string> active_peer_key: "";
    in-out property <string> active_peer_nick: "";
    in-out property <string> active_peer_initial: "P";
    in-out property <string> active_conn_info: "";
    in-out property <bool> active_is_direct: false;
    in-out property <bool> is_peer_typing: false;
    in-out property <[MessageData]> messages: [];
    in-out property <string> search_query: "";
    in-out property <string> input_text: "";
    in-out property <string> my_nickname: "Doot User";
    in-out property <string> my_initial: "D";
    in-out property <string> my_node_id: "";
    in-out property <string> my_ticket: "";
    in-out property <string> toast_banner: "";
    in-out property <bool> show_toast: false;
    in-out property <bool> show_connect_dialog: false;
    in-out property <string> connect_ticket_input: "";
    in-out property <string> connect_nickname_input: "";
    in-out property <bool> show_settings_dialog: false;
    in-out property <string> settings_nickname_input: "";

    // Callbacks
    callback select_contact(int);
    callback send_message(string);
    callback send_typing(bool);
    callback attach_file();
    callback ping_active_peer();
    callback copy_active_peer_key();
    callback open_attachment(string);
    callback connect_peer(string, string);
    callback update_nickname(string);
    callback copy_my_ticket();
    callback copy_my_node_id();
    callback close_toast();

    // Main Layout: Left Sidebar + Chat Panel
    HorizontalLayout {
        spacing: 0;

        // LEFT SIDEBAR (Width: 320px)
        Rectangle {
            width: 320px;
            background: #161922;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // Sidebar Header
                HorizontalLayout {
                    alignment: space-between;
                    height: 40px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Image {
                            width: 24px;
                            height: 24px;
                            source: @image-url("icons/logo.svg");
                            image-fit: contain;
                        }

                        Text {
                            text: "Doot";
                            font-size: 19px;
                            font-weight: 700;
                            color: #f8fafc;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            background: #143324;
                            border-radius: 6px;
                            border-color: #22c55e;
                            border-width: 1px;
                            height: 20px;
                            width: 62px;

                            Text {
                                text: "QUIC P2P";
                                font-size: 10px;
                                font-weight: 700;
                                color: #4ade80;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        IconButton {
                            icon: @image-url("icons/plus.svg");
                            icon-size: 16px;
                            clicked => {
                                root.show_connect_dialog = true;
                            }
                        }

                        IconButton {
                            icon: @image-url("icons/settings.svg");
                            icon-size: 16px;
                            clicked => {
                                root.settings_nickname_input = root.my_nickname;
                                root.show_settings_dialog = true;
                            }
                        }
                    }
                }

                // Search Bar
                Rectangle {
                    height: 40px;
                    border-radius: 20px;
                    background: #1f2430;
                    border-width: 1px;
                    border-color: search_input.has-focus ? #3b82f6 : #2a313f;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        alignment: center;

                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("icons/search.svg");
                            colorize: #64748b;
                            image-fit: contain;
                        }

                        search_input := TextInput {
                            text <=> root.search_query;
                            color: #f1f5f9;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    if root.search_query == "" && !search_input.has-focus: Text {
                        x: 40px;
                        text: "Search contacts...";
                        color: #64748b;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                // Contact Cards List
                ListView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    for contact[idx] in root.contacts: Rectangle {
                        height: 68px;
                        border-radius: 12px;
                        background: idx == root.selected_contact_index ? #232b3b : (item_touch.has-hover ? #1c222e : transparent);

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            alignment: center;

                            // Avatar Circle with Status Dot
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: idx == root.selected_contact_index ? #2563eb : #293244;

                                Text {
                                    text: contact.initial;
                                    font-size: 17px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Status Dot in bottom right corner
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    x: 32px;
                                    y: 32px;
                                    background: contact.is_direct ? #22c55e : (contact.is_online ? #eab308 : #64748b);
                                    border-width: 2px;
                                    border-color: #161922;
                                }
                            }

                            // Contact info
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: contact.nickname;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: idx == root.selected_contact_index ? #ffffff : #e2e8f0;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: contact.timestamp;
                                        font-size: 11px;
                                        color: #64748b;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: space-between;

                                    if contact.is_typing: Text {
                                        text: "typing...";
                                        font-size: 12px;
                                        color: #38bdf8;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if !contact.is_typing: Text {
                                        text: contact.last_message != "" ? contact.last_message : "Peer ready";
                                        font-size: 12px;
                                        color: #94a3b8;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if contact.unread_count > 0: Rectangle {
                                        background: #3b82f6;
                                        border-radius: 9px;
                                        height: 18px;
                                        min-width: 20px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: contact.unread_count;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        item_touch := TouchArea {
                            clicked => {
                                root.select_contact(idx);
                            }
                        }
                    }
                }

                // Sidebar Footer: Sovereign Identity Card
                Rectangle {
                    height: 56px;
                    border-radius: 12px;
                    background: #1c212d;
                    border-width: 1px;
                    border-color: #272f3f;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: #1e3a5f;

                            Text {
                                text: root.my_initial;
                                font-size: 15px;
                                font-weight: 700;
                                color: #60a5fa;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.my_nickname;
                                font-size: 13px;
                                font-weight: 600;
                                color: #f1f5f9;
                                overflow: elide;
                            }

                            Text {
                                text: root.my_node_id;
                                font-size: 10px;
                                color: #64748b;
                                overflow: elide;
                            }
                        }

                        IconButton {
                            icon: @image-url("icons/copy.svg");
                            icon-size: 15px;
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            bg-color: #252d3d;
                            bg-hover-color: #313a4e;
                            clicked => {
                                root.copy_my_ticket();
                            }
                        }
                    }
                }
            }
        }

        // Vertical divider
        Rectangle {
            width: 1px;
            background: #212633;
        }

        // RIGHT CHAT AREA
        Rectangle {
            horizontal-stretch: 1;
            background: #0f1117;

            // Empty State (No contact selected)
            if root.active_peer_key == "": VerticalLayout {
                alignment: center;
                spacing: 16px;

                Image {
                    width: 72px;
                    height: 72px;
                    source: @image-url("icons/logo.svg");
                    image-fit: contain;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Welcome to Doot";
                    font-size: 26px;
                    font-weight: 700;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Sovereign P2P Encrypted Messenger over Direct QUIC";
                    font-size: 14px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;

                    CustomButton {
                        text: "Connect with Peer";
                        primary: true;
                        clicked => {
                            root.show_connect_dialog = true;
                        }
                    }
                }
            }

            // Active Chat Conversation
            if root.active_peer_key != "": VerticalLayout {
                spacing: 0;

                // Chat Top Bar
                Rectangle {
                    height: 64px;
                    background: #161922;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                width: 42px;
                                height: 42px;
                                border-radius: 21px;
                                background: #2563eb;

                                Text {
                                    text: root.active_peer_initial;
                                    font-size: 17px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: root.active_peer_nick;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: #f1f5f9;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.active_is_direct ? #22c55e : #eab308;
                                    }

                                    Text {
                                        text: root.active_conn_info != "" ? root.active_conn_info : "Encrypted QUIC";
                                        font-size: 12px;
                                        color: #94a3b8;
                                    }
                                }
                            }
                        }

                        // Header Actions (Ping & Copy Key)
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            IconButton {
                                icon: @image-url("icons/bolt.svg");
                                icon-size: 16px;
                                clicked => {
                                    root.ping_active_peer();
                                }
                            }

                            IconButton {
                                icon: @image-url("icons/key.svg");
                                icon-size: 16px;
                                clicked => {
                                    root.copy_active_peer_key();
                                }
                            }
                        }
                    }
                }

                // Top bar divider
                Rectangle {
                    height: 1px;
                    background: #212633;
                }

                // Chat Message Stream
                ListView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    for msg in root.messages: Rectangle {
                        background: transparent;

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            alignment: msg.is_mine ? end : start;

                            Rectangle {
                                border-radius: 16px;
                                background: msg.is_mine ? #1e3a8a : #1c212d;
                                max-width: 520px;

                                VerticalLayout {
                                    padding: 10px;
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 5px;

                                    // File Attachment Card
                                    if msg.has_attachment: Rectangle {
                                        height: 50px;
                                        border-radius: 10px;
                                        background: msg.is_mine ? #172554 : #141720;
                                        border-width: 1px;
                                        border-color: msg.is_mine ? #2563eb : #2b3342;

                                        HorizontalLayout {
                                            padding: 8px;
                                            spacing: 10px;
                                            alignment: center;

                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                border-radius: 8px;
                                                background: #1e3a5f;

                                                Image {
                                                    width: 18px;
                                                    height: 18px;
                                                    source: msg.is_directory ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                                                    colorize: #60a5fa;
                                                    image-fit: contain;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 1px;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: msg.file_name;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #93c5fd;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: msg.file_size_text;
                                                    font-size: 11px;
                                                    color: #bfdbfe;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.open_attachment(msg.local_path);
                                            }
                                        }
                                    }

                                    // Message text content
                                    if msg.content != "": Text {
                                        text: msg.content;
                                        font-size: 14px;
                                        color: #f8fafc;
                                        wrap: word-wrap;
                                    }

                                    // Message Footer: Timestamp and Delivery Status
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 6px;

                                        Text {
                                            text: msg.timestamp;
                                            font-size: 10px;
                                            color: msg.is_mine ? #93c5fd : #64748b;
                                            vertical-alignment: center;
                                        }

                                        if msg.is_mine: Image {
                                            width: 14px;
                                            height: 14px;
                                            source: msg.status == "Delivered" ? @image-url("icons/check-all.svg") :
                                                   (msg.status == "Sent" ? @image-url("icons/check.svg") : @image-url("icons/clock.svg"));
                                            colorize: msg.status == "Delivered" ? #38bdf8 : #93c5fd;
                                            image-fit: contain;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Peer is typing banner
                if root.is_peer_typing: Rectangle {
                    height: 26px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #38bdf8;
                        }

                        Text {
                            text: "Peer is typing...";
                            font-size: 12px;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }
                }

                // Bottom input divider
                Rectangle {
                    height: 1px;
                    background: #212633;
                }

                // Chat Input Area
                Rectangle {
                    height: 68px;
                    background: #161922;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        alignment: center;

                        // Attach File Button
                        IconButton {
                            icon: @image-url("icons/attach.svg");
                            icon-size: 18px;
                            width: 42px;
                            height: 42px;
                            border-radius: 21px;
                            clicked => {
                                root.attach_file();
                            }
                        }

                        // Message Text Input
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 44px;
                            border-radius: 22px;
                            background: #1f2530;
                            border-width: 1px;
                            border-color: chat_input.has-focus ? #3b82f6 : #2a3242;

                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;

                                chat_input := TextInput {
                                    text <=> root.input_text;
                                    color: #f8fafc;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => {
                                        if (root.input_text != "") {
                                            root.send_message(root.input_text);
                                            root.input_text = "";
                                        }
                                    }
                                    edited => {
                                        root.send_typing(root.input_text != "");
                                    }
                                }
                            }

                            if root.input_text == "" && !chat_input.has-focus: Text {
                                x: 18px;
                                text: "Type an encrypted message...";
                                color: #64748b;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }

                        // Send Button
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: root.input_text != "" ? (send_touch.has-hover ? #1d4ed8 : #2563eb) : #242c3b;

                            Image {
                                width: 18px;
                                height: 18px;
                                source: @image-url("icons/send.svg");
                                colorize: root.input_text != "" ? #ffffff : #64748b;
                                image-fit: contain;
                            }

                            send_touch := TouchArea {
                                clicked => {
                                    if (root.input_text != "") {
                                        root.send_message(root.input_text);
                                        root.input_text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // CONNECT PEER MODAL DIALOG
    if root.show_connect_dialog: Rectangle {
        background: #000000b0;

        TouchArea {
            // Modal backdrop interceptor
        }

        Rectangle {
            width: 480px;
            height: 310px;
            border-radius: 16px;
            background: #1b202c;
            border-width: 1px;
            border-color: #2f384a;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Connect Peer over QUIC";
                        font-size: 18px;
                        font-weight: 700;
                        color: #f1f5f9;
                    }

                    IconButton {
                        icon: @image-url("icons/close.svg");
                        icon-size: 14px;
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        bg-color: transparent;
                        bg-hover-color: #2b3445;
                        clicked => {
                            root.show_connect_dialog = false;
                        }
                    }
                }

                Text {
                    text: "Paste peer's shareable ticket (doot:...) to establish a sovereign connection:";
                    font-size: 13px;
                    color: #94a3b8;
                    wrap: word-wrap;
                }

                // Ticket input
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: #151922;
                    border-width: 1px;
                    border-color: ticket_in.has-focus ? #3b82f6 : #28303f;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;

                        ticket_in := TextInput {
                            text <=> root.connect_ticket_input;
                            color: #f8fafc;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    if root.connect_ticket_input == "" && !ticket_in.has-focus: Text {
                        x: 14px;
                        text: "doot:... ticket";
                        color: #64748b;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                // Nickname input
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: #151922;
                    border-width: 1px;
                    border-color: nick_in.has-focus ? #3b82f6 : #28303f;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;

                        nick_in := TextInput {
                            text <=> root.connect_nickname_input;
                            color: #f8fafc;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    if root.connect_nickname_input == "" && !nick_in.has-focus: Text {
                        x: 14px;
                        text: "Peer nickname (optional)";
                        color: #64748b;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;

                    CustomButton {
                        text: "Cancel";
                        primary: false;
                        clicked => {
                            root.show_connect_dialog = false;
                        }
                    }

                    CustomButton {
                        text: "Connect";
                        primary: true;
                        clicked => {
                            if (root.connect_ticket_input != "") {
                                root.connect_peer(root.connect_ticket_input, root.connect_nickname_input);
                                root.connect_ticket_input = "";
                                root.connect_nickname_input = "";
                                root.show_connect_dialog = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // SETTINGS MODAL DIALOG
    if root.show_settings_dialog: Rectangle {
        background: #000000b0;

        TouchArea {
            // Modal backdrop interceptor
        }

        Rectangle {
            width: 520px;
            height: 380px;
            border-radius: 16px;
            background: #1b202c;
            border-width: 1px;
            border-color: #2f384a;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Doot Sovereign Settings";
                        font-size: 18px;
                        font-weight: 700;
                        color: #f1f5f9;
                    }

                    IconButton {
                        icon: @image-url("icons/close.svg");
                        icon-size: 14px;
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        bg-color: transparent;
                        bg-hover-color: #2b3445;
                        clicked => {
                            root.show_settings_dialog = false;
                        }
                    }
                }

                Text {
                    text: "Your Public Nickname:";
                    font-size: 13px;
                    font-weight: 600;
                    color: #cbd5e1;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        border-radius: 8px;
                        background: #151922;
                        border-width: 1px;
                        border-color: settings_nick.has-focus ? #3b82f6 : #28303f;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;

                            settings_nick := TextInput {
                                text <=> root.settings_nickname_input;
                                color: #f8fafc;
                                font-size: 13px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                    }

                    CustomButton {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.update_nickname(root.settings_nickname_input);
                        }
                    }
                }

                Text {
                    text: "Your Sovereign Shareable Ticket:";
                    font-size: 13px;
                    font-weight: 600;
                    color: #cbd5e1;
                }

                Rectangle {
                    height: 48px;
                    border-radius: 8px;
                    background: #151922;
                    border-width: 1px;
                    border-color: #28303f;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        alignment: space-between;

                        Text {
                            text: root.my_ticket;
                            font-size: 12px;
                            color: #94a3b8;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: @image-url("icons/copy.svg");
                            icon-size: 15px;
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            bg-color: #212937;
                            bg-hover-color: #2e384c;
                            clicked => {
                                root.copy_my_ticket();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;

                    CustomButton {
                        text: "Done";
                        primary: true;
                        clicked => {
                            root.show_settings_dialog = false;
                        }
                    }
                }
            }
        }
    }

    // TOAST NOTIFICATION BANNER
    if root.show_toast: Rectangle {
        y: 20px;
        x: (parent.width - self.width) / 2;
        width: 400px;
        height: 46px;
        border-radius: 23px;
        background: #19273c;
        border-width: 1px;
        border-color: #3b82f6;

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 14px;
            alignment: space-between;

            Text {
                text: root.toast_banner;
                font-size: 13px;
                font-weight: 600;
                color: #ffffff;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            IconButton {
                icon: @image-url("icons/close.svg");
                icon-size: 13px;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                bg-color: transparent;
                bg-hover-color: #28374d;
                clicked => {
                    root.close_toast();
                }
            }
        }
    }
}
