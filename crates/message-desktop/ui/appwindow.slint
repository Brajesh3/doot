import { ListView } from "std-widgets.slint";

// GLOBAL DESIGN SYSTEM TOKENS
global Theme {
    out property <color> bg_base: #0c0e14;
    out property <color> bg_surface: #141721;
    out property <color> bg_surface_elevated: #1c202d;
    out property <color> bg_surface_hover: #242938;
    out property <color> bg_active: #202636;

    out property <color> border_subtle: #232836;
    out property <color> border_focus: #3b82f6;

    out property <color> accent_primary: #2563eb;
    out property <color> accent_hover: #1d4ed8;
    out property <color> accent_bubble: #1e3a8a;
    out property <color> accent_bubble_border: #2563eb;

    out property <color> text_primary: #f8fafc;
    out property <color> text_secondary: #94a3b8;
    out property <color> text_muted: #64748b;
    out property <color> text_on_accent: #ffffff;

    out property <color> status_direct: #22c55e;
    out property <color> status_relay: #f59e0b;
    out property <color> status_offline: #64748b;
    out property <color> status_unread: #2563eb;

    out property <length> radius_sm: 6px;
    out property <length> radius_md: 10px;
    out property <length> radius_lg: 14px;
    out property <length> radius_xl: 16px;
    out property <length> radius_full: 999px;
}

export struct ContactData {
    peer_key: string,
    nickname: string,
    initial: string,
    last_message: string,
    timestamp: string,
    unread_count: int,
    is_online: bool,
    is_direct: bool,
    rtt_ms: int,
    is_typing: bool,
}

export struct MessageData {
    id: string,
    is_mine: bool,
    content: string,
    timestamp: string,
    status: string,
    has_attachment: bool,
    file_name: string,
    file_size_text: string,
    is_directory: bool,
    local_path: string,
}

component IconButton inherits Rectangle {
    in-out property <image> icon;
    in-out property <color> icon-color: Theme.text_secondary;
    in-out property <color> icon-hover-color: Theme.text_primary;
    in-out property <color> bg-color: Theme.bg_surface_elevated;
    in-out property <color> bg-hover-color: Theme.bg_surface_hover;
    in-out property <length> icon-size: 16px;
    callback clicked <=> touch.clicked;

    width: 36px;
    height: 36px;
    border-radius: Theme.radius_md;
    background: touch.has-hover ? bg-hover-color : bg-color;
    border-width: 1px;
    border-color: Theme.border_subtle;

    Image {
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: touch.has-hover ? root.icon-hover-color : root.icon-color;
        image-fit: contain;
    }

    touch := TouchArea {}
}

component ActionButton inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> primary: false;
    callback clicked <=> touch.clicked;

    height: 38px;
    border-radius: Theme.radius_md;
    background: root.primary ?
        (touch.has-hover ? Theme.accent_hover : Theme.accent_primary) :
        (touch.has-hover ? Theme.bg_surface_hover : Theme.bg_surface_elevated);
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.border_subtle;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.primary ? Theme.text_on_accent : Theme.text_secondary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {}
}

export component AppWindow inherits Window {
    title: "Doot - Sovereign P2P Messenger";
    min-width: 860px;
    min-height: 600px;
    preferred-width: 1060px;
    preferred-height: 720px;
    background: Theme.bg_base;
    default-font-family: "Segoe UI";

    // Properties
    in-out property <[ContactData]> contacts: [];
    in-out property <int> selected_contact_index: -1;
    in-out property <string> active_peer_key: "";
    in-out property <string> active_peer_nick: "";
    in-out property <string> active_peer_initial: "P";
    in-out property <string> active_conn_info: "";
    in-out property <bool> active_is_direct: false;
    in-out property <bool> is_peer_typing: false;
    in-out property <[MessageData]> messages: [];
    in-out property <string> search_query: "";
    in-out property <string> input_text: "";
    in-out property <string> my_nickname: "Doot User";
    in-out property <string> my_initial: "D";
    in-out property <string> my_node_id: "";
    in-out property <string> my_ticket: "";
    in-out property <string> toast_banner: "";
    in-out property <bool> show_toast: false;
    in-out property <bool> show_connect_dialog: false;
    in-out property <string> connect_ticket_input: "";
    in-out property <string> connect_nickname_input: "";
    in-out property <bool> show_settings_dialog: false;
    in-out property <string> settings_nickname_input: "";

    // Callbacks
    callback select_contact(int);
    callback send_message(string);
    callback send_typing(bool);
    callback attach_file();
    callback ping_active_peer();
    callback copy_active_peer_key();
    callback open_attachment(string);
    callback connect_peer(string, string);
    callback update_nickname(string);
    callback copy_my_ticket();
    callback copy_my_node_id();
    callback close_toast();

    // MAIN CONTAINER: Sidebar + Divider + Chat Area
    HorizontalLayout {
        spacing: 0;

        // LEFT SIDEBAR (Width: 320px)
        Rectangle {
            width: 320px;
            background: Theme.bg_surface;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                // Sidebar Header
                HorizontalLayout {
                    alignment: space-between;
                    height: 40px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Image {
                            width: 22px;
                            height: 22px;
                            source: @image-url("icons/logo.svg");
                            image-fit: contain;
                        }

                        Text {
                            text: "Doot";
                            font-size: 18px;
                            font-weight: 700;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            background: #11291b;
                            border-radius: Theme.radius_sm;
                            border-color: #22c55e;
                            border-width: 1px;
                            height: 20px;
                            width: 62px;

                            Text {
                                text: "QUIC P2P";
                                font-size: 10px;
                                font-weight: 700;
                                color: #4ade80;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        IconButton {
                            icon: @image-url("icons/plus.svg");
                            icon-size: 15px;
                            clicked => {
                                root.show_connect_dialog = true;
                            }
                        }

                        IconButton {
                            icon: @image-url("icons/settings.svg");
                            icon-size: 15px;
                            clicked => {
                                root.settings_nickname_input = root.my_nickname;
                                root.show_settings_dialog = true;
                            }
                        }
                    }
                }

                // Search Bar
                Rectangle {
                    height: 38px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface_elevated;
                    border-width: 1px;
                    border-color: search_input.has-focus ? Theme.border_focus : Theme.border_subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Image {
                            width: 15px;
                            height: 15px;
                            source: @image-url("icons/search.svg");
                            colorize: Theme.text_muted;
                            image-fit: contain;
                        }

                        search_input := TextInput {
                            text <=> root.search_query;
                            color: Theme.text_primary;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    if root.search_query == "" && !search_input.has-focus: Text {
                        x: 36px;
                        text: "Search contacts...";
                        color: Theme.text_muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                // Contacts List
                ListView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    for contact[idx] in root.contacts: Rectangle {
                        height: 64px;
                        border-radius: Theme.radius_md;
                        background: idx == root.selected_contact_index ? Theme.bg_active : (item_touch.has-hover ? Theme.bg_surface_hover : transparent);
                        border-width: idx == root.selected_contact_index ? 1px : 0px;
                        border-color: Theme.border_subtle;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            alignment: center;

                            // Avatar Circle with Status Dot
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: idx == root.selected_contact_index ? Theme.accent_primary : Theme.bg_surface_elevated;
                                border-width: 1px;
                                border-color: Theme.border_subtle;

                                Text {
                                    text: contact.initial;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: Theme.text_on_accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Status Dot in bottom right
                                Rectangle {
                                    width: 11px;
                                    height: 11px;
                                    border-radius: 5.5px;
                                    x: 29px;
                                    y: 29px;
                                    background: contact.is_direct ? Theme.status_direct : (contact.is_online ? Theme.status_relay : Theme.status_offline);
                                    border-width: 2px;
                                    border-color: Theme.bg_surface;
                                }
                            }

                            // Contact info
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: contact.nickname;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: idx == root.selected_contact_index ? Theme.text_on_accent : Theme.text_primary;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: contact.timestamp;
                                        font-size: 11px;
                                        color: Theme.text_muted;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: space-between;

                                    if contact.is_typing: Text {
                                        text: "typing...";
                                        font-size: 12px;
                                        color: #38bdf8;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if !contact.is_typing: Text {
                                        text: contact.last_message != "" ? contact.last_message : "Encrypted peer";
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if contact.unread_count > 0: Rectangle {
                                        background: Theme.status_unread;
                                        border-radius: 9px;
                                        height: 18px;
                                        min-width: 20px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: contact.unread_count;
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        item_touch := TouchArea {
                            clicked => {
                                root.select_contact(idx);
                            }
                        }
                    }
                }

                // Sidebar Footer: Sovereign Identity Card
                Rectangle {
                    height: 52px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface_elevated;
                    border-width: 1px;
                    border-color: Theme.border_subtle;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: #19273c;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            Text {
                                text: root.my_initial;
                                font-size: 14px;
                                font-weight: 700;
                                color: #60a5fa;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.my_nickname;
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text_primary;
                                overflow: elide;
                            }

                            Text {
                                text: root.my_node_id;
                                font-size: 10px;
                                color: Theme.text_muted;
                                overflow: elide;
                            }
                        }

                        IconButton {
                            icon: @image-url("icons/copy.svg");
                            icon-size: 14px;
                            width: 30px;
                            height: 30px;
                            clicked => {
                                root.copy_my_ticket();
                            }
                        }
                    }
                }
            }
        }

        // 1px Vertical Divider
        Rectangle {
            width: 1px;
            background: Theme.border_subtle;
        }

        // RIGHT CHAT PANEL
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg_base;

            // Empty State (No contact selected)
            if root.active_peer_key == "": VerticalLayout {
                alignment: center;
                spacing: 14px;

                Image {
                    width: 64px;
                    height: 64px;
                    source: @image-url("icons/logo.svg");
                    image-fit: contain;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Welcome to Doot";
                    font-size: 24px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Sovereign P2P Encrypted Messenger over Direct QUIC";
                    font-size: 13px;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;

                    ActionButton {
                        text: "Connect with Peer";
                        primary: true;
                        clicked => {
                            root.show_connect_dialog = true;
                        }
                    }
                }
            }

            // Active Conversation
            if root.active_peer_key != "": VerticalLayout {
                spacing: 0;

                // Chat Top Bar (Height: 60px)
                Rectangle {
                    height: 60px;
                    background: Theme.bg_surface;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.accent_primary;

                                Text {
                                    text: root.active_peer_initial;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: Theme.text_on_accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: root.active_peer_nick;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text_primary;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.active_is_direct ? Theme.status_direct : Theme.status_relay;
                                    }

                                    Text {
                                        text: root.active_conn_info != "" ? root.active_conn_info : "Encrypted QUIC";
                                        font-size: 11px;
                                        color: Theme.text_secondary;
                                    }
                                }
                            }
                        }

                        // Top Bar Actions
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            IconButton {
                                icon: @image-url("icons/bolt.svg");
                                icon-size: 15px;
                                clicked => {
                                    root.ping_active_peer();
                                }
                            }

                            IconButton {
                                icon: @image-url("icons/key.svg");
                                icon-size: 15px;
                                clicked => {
                                    root.copy_active_peer_key();
                                }
                            }
                        }
                    }
                }

                // 1px Horizontal Divider
                Rectangle {
                    height: 1px;
                    background: Theme.border_subtle;
                }

                // Messages Stream
                ListView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    for msg in root.messages: Rectangle {
                        background: transparent;

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            alignment: msg.is_mine ? end : start;

                            Rectangle {
                                border-radius: Theme.radius_lg;
                                background: msg.is_mine ? Theme.accent_bubble : Theme.bg_surface_elevated;
                                border-width: 1px;
                                border-color: msg.is_mine ? Theme.accent_bubble_border : Theme.border_subtle;
                                max-width: 520px;

                                VerticalLayout {
                                    padding: 9px;
                                    padding-left: 13px;
                                    padding-right: 13px;
                                    spacing: 5px;

                                    // File Attachment Card
                                    if msg.has_attachment: Rectangle {
                                        height: 48px;
                                        border-radius: Theme.radius_md;
                                        background: Theme.bg_surface;
                                        border-width: 1px;
                                        border-color: Theme.border_subtle;

                                        HorizontalLayout {
                                            padding: 8px;
                                            spacing: 10px;
                                            alignment: center;

                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: Theme.radius_sm;
                                                background: Theme.bg_surface_elevated;

                                                Image {
                                                    width: 16px;
                                                    height: 16px;
                                                    source: msg.is_directory ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                                                    colorize: #60a5fa;
                                                    image-fit: contain;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 1px;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: msg.file_name;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #93c5fd;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: msg.file_size_text;
                                                    font-size: 11px;
                                                    color: Theme.text_muted;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.open_attachment(msg.local_path);
                                            }
                                        }
                                    }

                                    // Message content
                                    if msg.content != "": Text {
                                        text: msg.content;
                                        font-size: 14px;
                                        color: Theme.text_primary;
                                        wrap: word-wrap;
                                    }

                                    // Message Footer
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 5px;

                                        Text {
                                            text: msg.timestamp;
                                            font-size: 10px;
                                            color: msg.is_mine ? #93c5fd : Theme.text_muted;
                                            vertical-alignment: center;
                                        }

                                        if msg.is_mine: Image {
                                            width: 13px;
                                            height: 13px;
                                            source: msg.status == "Delivered" ? @image-url("icons/check-all.svg") :
                                                   (msg.status == "Sent" ? @image-url("icons/check.svg") : @image-url("icons/clock.svg"));
                                            colorize: msg.status == "Delivered" ? #38bdf8 : #93c5fd;
                                            image-fit: contain;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Peer typing indicator
                if root.is_peer_typing: Rectangle {
                    height: 24px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 20px;
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #38bdf8;
                        }

                        Text {
                            text: "Peer is typing...";
                            font-size: 11px;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }
                }

                // 1px Horizontal Divider
                Rectangle {
                    height: 1px;
                    background: Theme.border_subtle;
                }

                // Chat Input Bar (Height: 64px)
                Rectangle {
                    height: 64px;
                    background: Theme.bg_surface;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;

                        // Attach Button
                        IconButton {
                            icon: @image-url("icons/attach.svg");
                            icon-size: 17px;
                            width: 38px;
                            height: 38px;
                            clicked => {
                                root.attach_file();
                            }
                        }

                        // Message Text Field
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 40px;
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface_elevated;
                            border-width: 1px;
                            border-color: chat_input.has-focus ? Theme.border_focus : Theme.border_subtle;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;

                                chat_input := TextInput {
                                    text <=> root.input_text;
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => {
                                        if (root.input_text != "") {
                                            root.send_message(root.input_text);
                                            root.input_text = "";
                                        }
                                    }
                                    edited => {
                                        root.send_typing(root.input_text != "");
                                    }
                                }
                            }

                            if root.input_text == "" && !chat_input.has-focus: Text {
                                x: 14px;
                                text: "Type an encrypted message...";
                                color: Theme.text_muted;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        // Send Button
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: Theme.radius_md;
                            background: root.input_text != "" ? (send_touch.has-hover ? Theme.accent_hover : Theme.accent_primary) : Theme.bg_surface_elevated;
                            border-width: root.input_text != "" ? 0 : 1px;
                            border-color: Theme.border_subtle;

                            Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("icons/send.svg");
                                colorize: root.input_text != "" ? Theme.text_on_accent : Theme.text_muted;
                                image-fit: contain;
                            }

                            send_touch := TouchArea {
                                clicked => {
                                    if (root.input_text != "") {
                                        root.send_message(root.input_text);
                                        root.input_text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // CONNECT PEER MODAL DIALOG
    if root.show_connect_dialog: Rectangle {
        background: #00000099;

        TouchArea {
            // Prevent click-through
        }

        Rectangle {
            width: 480px;
            height: 310px;
            border-radius: Theme.radius_xl;
            background: Theme.bg_surface;
            border-width: 1px;
            border-color: Theme.border_subtle;

            VerticalLayout {
                padding: 22px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Connect Peer over QUIC";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }

                    IconButton {
                        icon: @image-url("icons/close.svg");
                        icon-size: 13px;
                        width: 30px;
                        height: 30px;
                        clicked => {
                            root.show_connect_dialog = false;
                        }
                    }
                }

                Text {
                    text: "Paste peer's sovereign ticket (doot:...) to establish a direct connection:";
                    font-size: 13px;
                    color: Theme.text_secondary;
                    wrap: word-wrap;
                }

                // Ticket input
                Rectangle {
                    height: 40px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface_elevated;
                    border-width: 1px;
                    border-color: ticket_in.has-focus ? Theme.border_focus : Theme.border_subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        ticket_in := TextInput {
                            text <=> root.connect_ticket_input;
                            color: Theme.text_primary;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    if root.connect_ticket_input == "" && !ticket_in.has-focus: Text {
                        x: 12px;
                        text: "doot:... ticket";
                        color: Theme.text_muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                // Nickname input
                Rectangle {
                    height: 40px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface_elevated;
                    border-width: 1px;
                    border-color: nick_in.has-focus ? Theme.border_focus : Theme.border_subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        nick_in := TextInput {
                            text <=> root.connect_nickname_input;
                            color: Theme.text_primary;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }

                    if root.connect_nickname_input == "" && !nick_in.has-focus: Text {
                        x: 12px;
                        text: "Peer nickname (optional)";
                        color: Theme.text_muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    ActionButton {
                        text: "Cancel";
                        primary: false;
                        clicked => {
                            root.show_connect_dialog = false;
                        }
                    }

                    ActionButton {
                        text: "Connect";
                        primary: true;
                        clicked => {
                            if (root.connect_ticket_input != "") {
                                root.connect_peer(root.connect_ticket_input, root.connect_nickname_input);
                                root.connect_ticket_input = "";
                                root.connect_nickname_input = "";
                                root.show_connect_dialog = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // SETTINGS MODAL DIALOG
    if root.show_settings_dialog: Rectangle {
        background: #00000099;

        TouchArea {
            // Prevent click-through
        }

        Rectangle {
            width: 500px;
            height: 360px;
            border-radius: Theme.radius_xl;
            background: Theme.bg_surface;
            border-width: 1px;
            border-color: Theme.border_subtle;

            VerticalLayout {
                padding: 22px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Doot Sovereign Settings";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }

                    IconButton {
                        icon: @image-url("icons/close.svg");
                        icon-size: 13px;
                        width: 30px;
                        height: 30px;
                        clicked => {
                            root.show_settings_dialog = false;
                        }
                    }
                }

                Text {
                    text: "Your Public Nickname:";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text_secondary;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        border-radius: Theme.radius_md;
                        background: Theme.bg_surface_elevated;
                        border-width: 1px;
                        border-color: settings_nick.has-focus ? Theme.border_focus : Theme.border_subtle;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            settings_nick := TextInput {
                                text <=> root.settings_nickname_input;
                                color: Theme.text_primary;
                                font-size: 13px;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }
                    }

                    ActionButton {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.update_nickname(root.settings_nickname_input);
                        }
                    }
                }

                Text {
                    text: "Your Sovereign Shareable Ticket:";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text_secondary;
                }

                Rectangle {
                    height: 44px;
                    border-radius: Theme.radius_md;
                    background: Theme.bg_surface_elevated;
                    border-width: 1px;
                    border-color: Theme.border_subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        alignment: space-between;

                        Text {
                            text: root.my_ticket;
                            font-size: 11px;
                            color: Theme.text_secondary;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: @image-url("icons/copy.svg");
                            icon-size: 14px;
                            width: 32px;
                            height: 32px;
                            clicked => {
                                root.copy_my_ticket();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;

                    ActionButton {
                        text: "Done";
                        primary: true;
                        clicked => {
                            root.show_settings_dialog = false;
                        }
                    }
                }
            }
        }
    }

    // TOAST NOTIFICATION BANNER
    if root.show_toast: Rectangle {
        y: 16px;
        x: (parent.width - self.width) / 2;
        width: 380px;
        height: 42px;
        border-radius: Theme.radius_full;
        background: Theme.bg_surface_elevated;
        border-width: 1px;
        border-color: Theme.accent_primary;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            alignment: space-between;

            Text {
                text: root.toast_banner;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text_primary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            IconButton {
                icon: @image-url("icons/close.svg");
                icon-size: 12px;
                width: 26px;
                height: 26px;
                clicked => {
                    root.close_toast();
                }
            }
        }
    }
}
